# Copy to .env or set these in your shell. All are optional; these are the defaults.
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
VISION_MODEL=llava:7b
REDIS_URL=redis://localhost:6379/0
PG_DSN=postgresql://market:market@localhost:5432/market
OSRM_URL=http://localhost:5000
CORS_ORIGINS=*
# Accounts and delivery
SESSION_DAYS=30
# POST {"to": phone, "message": text} to your SMS gateway when an OTP is created (optional)
SMS_WEBHOOK_URL=
# Look up unknown pincodes on OpenStreetMap (needs internet). 0 = fully offline
GEOCODE_ONLINE=1
# Admin panel
ADMIN_SESSION_HOURS=2
# 1 shows /docs (every API route). Keep 0 on a public server
ENABLE_DOCS=0

